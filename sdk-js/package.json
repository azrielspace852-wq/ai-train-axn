{
  "name": "aittrain-sdk",
  "version": "1.2.0",
  "description": "JavaScript SDK (Node.js + browser, zero dependency) untuk platform AITTrain agnostic AI training runner",
  "type": "module",
  "main": "./dist/aittrain.cjs",
  "module": "./dist/aittrain.mjs",
  "browser": "./dist/aittrain.min.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/aittrain.mjs",
      "require": "./dist/aittrain.cjs",
      "browser": "./dist/aittrain.browser.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./src/node/index.js",
      "require": "./dist/node.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/aittrain.browser.js",
      "default": "./dist/aittrain.min.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "aittrain-js": "./dist/cli.cjs"
  },
  "files": [
    "src",
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "aittrain",
    "ai-training",
    "sdk",
    "serverless-gpu",
    "github-actions",
    "sse"
  ],
  "author": "azrielspace852-wq",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azrielspace852-wq/ai-train-axn.git"
  },
  "bugs": {
    "url": "https://github.com/azrielspace852-wq/ai-train-axn/issues"
  },
  "homepage": "https://github.com/azrielspace852-wq/ai-train-axn#readme",
  "devDependencies": {
    "esbuild": "^0.21.5"
  }
}